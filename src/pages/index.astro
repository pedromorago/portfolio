---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Clients from "../components/Clients.astro";
import Challenges from "../components/Challenges.astro";
import Work from "../components/Work.astro";
import Why from "../components/Why.astro";
import Focus from "../components/Focus.astro";
import Poker from "../components/Poker.astro";
import Method from "../components/Method.astro";
import Career from "../components/Career.astro";
import Contact from "../components/Contact.astro";
import { SITE_URL, site, ogImageUrl } from "../lib/site";
import { homeJsonLd } from "../lib/seo";

const m = site.meta;
---

<Base
  kind="home"
  url={SITE_URL}
  title={m.title}
  description={m.description}
  ogType="profile"
  ogImage={ogImageUrl("og-image.png")}
  ogImageAlt={`${site.hero.name}, ${site.person.jobTitle}`}
  ogDescription={m.ogDescription}
  jsonLd={homeJsonLd(m.title)}
>
  <main id={site.skipLink.target}>
    <Hero />
    <Clients />
    <Why />
    <Work />
    <Focus />
    <Challenges />
    <Method />
    <Poker />
    <Career />
    <Contact />
  </main>
</Base>
