---
// The source of pedro-morago-cv.pdf (npm run cv prints it to public/).
// The copy lives in src/data/cv.json, laid out for one A4 page. Not indexed:
// the PDF is what people download.
import "@fontsource-variable/inter/wght.css";
import "@fontsource-variable/inter-tight";
import { Image } from "astro:assets";
import { site } from "../lib/site";
import { headshot } from "../lib/images";
import cv from "../data/cv.json";
import { assertContent } from "../lib/render";

assertContent(cv, "$", "src/data/cv.json");
const p = site.person;
---

<!doctype html>
<html lang={site.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{p.name}, CV</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://pedromorago.com/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="page">
      <header class="head">
        <div class="photo"><Image src={headshot} alt="" width={200} height={200} /></div>
        <div>
          <h1>{p.name}</h1>
          <p class="role">{cv.headline} <span class="headline-skills">{site.hero.skills.join(" | ")}</span></p>
          <p class="contact">
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
            <a href="https://pedromorago.com/">pedromorago.com</a>
            <a href="https://www.linkedin.com/in/pedro-morago-lopezvazquez/">linkedin.com/in/pedro-morago-lopezvazquez</a>
            <a href="https://github.com/pedromorago">github.com/pedromorago</a>
            <span>Santander, Spain (CET). Fully remote since 2021.</span>
          </p>
        </div>
      </header>

      <p class="summary">{cv.summary}</p>

      <div class="cols">
        <div class="main">
          <section>
            <h2>Experience</h2>
            {
              cv.jobs.map((j) => (
                <article class="job">
                  <div class="job-head">
                    <h3>
                      {j.role}, <span>{j.org}</span>
                    </h3>
                    <p class="dates">{j.dates}</p>
                  </div>
                  <p class="context">{j.meta}</p>
                  <ul>
                    {j.bullets.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </section>

          <section>
            <h2>{cv.fitTitle}</h2>
            <ul class="fit">
              {cv.fit.map((x) => <li>{x}</li>)}
            </ul>
          </section>

          <section>
            <h2>Skills</h2>
            {
              cv.skills.map((s) => (
                <p class="skill">
                  <strong>{s.title}:</strong> {s.text}
                </p>
              ))
            }
          </section>
        </div>

        <aside class="side">
          <section>
            <h2>Education and certification</h2>
            {
              cv.education.map((e) => (
                <div class="item">
                  <h3>{e.title}</h3>
                  <p>
                    {e.org}, {e.dates}
                  </p>
                </div>
              ))
            }
          </section>
          <section>
            <h2>Projects</h2>
            {
              cv.projects.map((x) => (
                <article class="proj">
                  <h3>{x.title}</h3>
                  <p class="link">{x.url}</p>
                  <p>{x.text}</p>
                </article>
              ))
            }
          </section>
          <section>
            <h2>Languages</h2>
            {cv.languages.map((l) => <p class="item">{l}</p>)}
          </section>
          <p class="note">
            {cv.note} <a href={`https://${cv.noteLink}`}>{cv.noteLink}</a>
          </p>
        </aside>
      </div>
    </main>
  </body>
</html>

<style>
  @page {
    size: A4;
    margin: 0;
  }
  :root {
    --ink: #16161a;
    --ink-2: #4a4a52;
    --line: #e3e0da;
    --accent: #1f5fa6;
  }
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  html {
    background: #d9d6d0;
  }
  body {
    font-family: "Inter Tight Variable", system-ui, sans-serif;
    color: var(--ink);
    font-size: 8.3pt;
    line-height: 1.45;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .page {
    width: 210mm;
    height: 297mm;
    overflow: hidden;
    margin: 24px auto;
    padding: 10mm 12mm 8mm;
    background: #fbfaf7;
  }
  @media print {
    html {
      background: none;
    }
    .page {
      margin: 0;
    }
  }
  /* On screen, contact links are easier to hit; the printed page keeps its size. */
  @media screen {
    .contact a {
      display: inline-block;
      padding: 4px 0;
    }
  }
  @media screen and (max-width: 840px) {
    .page {
      width: auto;
      height: auto;
      overflow: visible;
      margin: 0;
      padding: 24px 20px;
    }
    .cols {
      grid-template-columns: 1fr !important;
    }
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  .head {
    display: flex;
    gap: 16px;
    align-items: center;
    padding-bottom: 5mm;
    border-bottom: 1px solid var(--line);
  }
  .photo {
    flex: none;
    width: 25mm;
    height: 25mm;
    border-radius: 50%;
    overflow: hidden;
    background: #0f1a2a;
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
  }
  h1 {
    font-family: "Inter Variable", "Inter Tight Variable", system-ui, sans-serif;
    font-weight: 650;
    letter-spacing: -0.03em;
    font-size: 24pt;
    line-height: 1;
  }
  .headline-skills {
    margin-left: 6px;
    font-size: 8.6pt;
    font-weight: 400;
    color: var(--ink-2);
  }
  .role {
    margin-top: 2px;
    font-size: 11pt;
    font-weight: 600;
    color: var(--accent);
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 14px;
    margin-top: 5px;
    color: var(--ink-2);
    font-size: 8.4pt;
  }
  .summary {
    margin-top: 3.5mm;
    font-size: 9pt;
    line-height: 1.45;
  }
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 50mm;
    gap: 6mm;
    margin-top: 4mm;
  }
  h2 {
    font-size: 7.6pt;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    padding-bottom: 1.5mm;
    border-bottom: 1px solid var(--line);
    margin-bottom: 2.5mm;
  }
  section + section {
    margin-top: 3.8mm;
  }
  .job + .job {
    margin-top: 3.2mm;
  }
  .job-head {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    align-items: baseline;
  }
  h3 {
    font-size: 9.8pt;
    font-weight: 600;
    line-height: 1.3;
  }
  h3 span {
    font-weight: 500;
    color: var(--ink-2);
  }
  .dates {
    flex: none;
    font-size: 8.2pt;
    color: var(--ink-2);
  }
  .context {
    color: var(--ink-2);
    font-size: 8.6pt;
  }
  .job ul {
    margin-top: 1.2mm;
    padding-left: 3.6mm;
  }
  .job li + li {
    margin-top: 0.6mm;
  }
  .job li::marker {
    color: var(--accent);
  }
  .proj + .proj {
    margin-top: 2.6mm;
  }
  .proj p {
    color: var(--ink-2);
  }
  .link {
    font-size: 8pt;
    color: var(--accent);
  }
  .item + .item {
    margin-top: 1.6mm;
  }
  .item p,
  p.item {
    color: var(--ink-2);
  }
  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
  }
  .chips li {
    font-size: 8pt;
    padding: 1px 6px;
    border: 1px solid var(--line);
    border-radius: 99px;
    background: #fff;
  }
.skill + .skill {
    margin-top: 1mm;
  }
  .skill strong {
    font-weight: 600;
  }
  .fit {
    padding-left: 3.6mm;
  }
  .fit li + li {
    margin-top: 0.6mm;
  }
  .fit li::marker {
    color: var(--accent);
  }
  .note a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    word-break: break-all;
  }
  .note {
    margin-top: 4mm;
    font-size: 8pt;
    font-style: italic;
    color: var(--ink-2);
  }
  .method {
    padding-left: 4mm;
    color: var(--ink-2);
  }
  .method li + li {
    margin-top: 0.8mm;
  }
</style>
