---
// The portfolio. Projects are data in src/data/site.json: work.groups, each
// with a title, a note and its projects. A project can carry
// "status": "in-progress" to show a badge; only add a project once it has real
// content: a repo, a demo or a write-up.
import { Picture } from "astro:assets";
import { site } from "../lib/site";
import { shot } from "../lib/images";
import { hrefOf, renderLink, smart } from "../lib/render";

const w = site.work;
type Project = (typeof w.groups)[number]["projects"][number] & { status?: string };
---

<section id={w.id} class="section">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <p class="kicker">{w.kicker}</p>
        <h2 class="section-title">{smart(w.title)}</h2>
      </div>
      <p class="section-lede">{w.lede}</p>
    </div>


    {
      w.groups.map((g, gi) => (
        <div class="work-group">
          <div class="work-group-head reveal">
            <h3 class="work-group-title">{g.title}</h3>
            <p class="work-group-note">{smart(g.note)}</p>
            <div class="row-nav" hidden>
              <span class="row-count" aria-live="polite" />
              <button type="button" class="row-btn" data-step="-1" aria-label={w.prev} aria-controls={`projects-${gi}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
              </button>
              <button type="button" class="row-btn" data-step="1" aria-label={w.next} aria-controls={`projects-${gi}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
              </button>
            </div>
          </div>
          <ul class="apps-grid" id={`projects-${gi}`} aria-label={g.title}>
            {
              (g.projects as Project[]).map((a) => (
                <li class="card app-card reveal">
                  <a class="card-visual" href={hrefOf(a.page)} tabindex="-1" aria-hidden="true">
                    <Picture
                      src={shot(a.visual)}
                      alt=""
                      widths={[400, 700, 1000]}
                      sizes="(max-width: 700px) 100vw, 420px"
                      formats={["avif", "webp"]}
                    />
                  </a>
                  <div class="card-body">
                    <p class="feature-index">
                      {a.kicker}
                      {a.status === "in-progress" && <span class="badge">In progress</span>}
                    </p>
                    <h4>
                      <a href={hrefOf(a.page)}>{a.title}</a>
                    </h4>
                    <p>{smart(a.summary)}</p>
                    <div class="card-links">
                      <a class="btn btn-small btn-light" href={hrefOf(a.page)}>
                        View project<span class="sr-only">: {a.title}</span> <span class="arrow" aria-hidden="true">→</span>
                      </a>
                      <Fragment set:html={a.links.map((l) => renderLink(l, "btn btn-small")).join("")} />
                    </div>
                  </div>
                </li>
              ))
            }
          </ul>
          <div class="swipe-dots" aria-hidden="true" />
        </div>
      ))
    }
  </div>
</section>
