---
import { Picture } from "astro:assets";
import { site } from "../lib/site";
import { shot } from "../lib/images";
import { inline, renderLink, smart } from "../lib/render";

const w = site.work;
---

<section id={w.id} class="section">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <p class="kicker">{w.kicker}</p>
        <h2 class="section-title">{smart(w.title)}</h2>
      </div>
      <p class="section-lede">{w.lede}</p>
    </div>

    {
      w.apps.map((a, i) => (
        <article class="feature app reveal">
          <div class="feature-copy">
            <p class="feature-index">
              {String(i + 1).padStart(2, "0")} / {a.kicker}
            </p>
            <h3>{a.title}</h3>
            <dl class="story">
              {a.story.map((s) => (
                <div>
                  <dt>{s.label}</dt>
                  <dd set:html={inline(s.text)} />
                </div>
              ))}
            </dl>
            <ul class="tags">
              {a.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
            <div class="card-links">
              <Fragment set:html={a.links.map((l, j) => renderLink(l, j === 0 ? "btn btn-small btn-light" : "btn btn-small")).join("")} />
            </div>
          </div>
          <div class="feature-visual">
            <Picture
              src={shot(a.visual)}
              alt={a.visualAlt}
              widths={[480, 800, 1200]}
              sizes="(max-width: 900px) 100vw, 700px"
              formats={["avif", "webp"]}
            />
          </div>
        </article>
      ))
    }
  </div>
</section>
