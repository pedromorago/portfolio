---
import { Picture } from "astro:assets";
import { site } from "../lib/site";
import { shot } from "../lib/images";
import { hrefOf, renderLink, smart } from "../lib/render";

const w = site.work;
---

<section id={w.id} class="section">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <p class="kicker">{w.kicker}</p>
        <h2 class="section-title">{smart(w.title)}</h2>
      </div>
      <p class="section-lede">{w.lede}</p>
    </div>

    <ul class="apps-grid">
      {
        w.apps.map((a) => (
          <li class="card app-card reveal">
            <a class="card-visual" href={hrefOf(a.page)} tabindex="-1" aria-hidden="true">
              <Picture
                src={shot(a.visual)}
                alt=""
                widths={[480, 800, 1200]}
                sizes="(max-width: 760px) 100vw, 620px"
                formats={["avif", "webp"]}
              />
            </a>
            <div class="card-body">
              <p class="feature-index">{a.kicker}</p>
              <h3>
                <a href={hrefOf(a.page)}>{a.title}</a>
              </h3>
              <p>{a.summary}</p>
              <div class="card-links">
                <a class="btn btn-small btn-light" href={hrefOf(a.page)}>
                  View project<span class="sr-only">: {a.title}</span> <span class="arrow" aria-hidden="true">→</span>
                </a>
                <Fragment set:html={a.links.map((l) => renderLink(l, "btn btn-small")).join("")} />
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
