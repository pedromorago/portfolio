---
import { site } from "../lib/site";
import { inline, renderLink, smart } from "../lib/render";
const c = site.career;
---

<section id={c.id} class="section">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <p class="kicker">{c.kicker}</p>
        <h2 class="section-title">{smart(c.title)}</h2>
      </div>
      <p class="section-lede">{c.lede}</p>
    </div>
    <div class="career-grid">
      <ol class="timeline">
        {
          c.jobs.map((j, i) => (
            <li class:list={["job reveal", { current: i === 0 }]}>
              <p class="job-dates">{j.dates}</p>
              {j.edu ? (
                <h3>
                  {j.role}
                  <span class="job-org">{j.org}</span>
                </h3>
              ) : (
                <h3>
                  {j.role} <span class="at">at</span> {j.org}
                </h3>
              )}
              <p class="job-context">{j.context}</p>
              {j.bullets && (
                <ul>
                  {j.bullets.map((b) => (
                    <li set:html={inline(b)} />
                  ))}
                </ul>
              )}
              {j.link && <Fragment set:html={renderLink(j.link, "job-link")} />}
            </li>
          ))
        }
      </ol>
      <aside class="career-aside" aria-label="Certification, languages, references and tools">
        {
          c.aside.blocks.map((b) => (
            <div class="aside-card">
              <h3>{b.title}</h3>
              <ul>
                {b.items.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </div>
          ))
        }
        <div class="aside-card">
          <h3>{c.aside.toolsTitle}</h3>
          <ul class="chips">
            {c.aside.tools.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        <div class="aside-actions">
          <Fragment
            set:html={c.actions
              .map((a, i) =>
                renderLink(a, i === 0 ? "btn btn-primary" : "btn").replace(
                  "</a>",
                  a.href.endsWith(".pdf") ? '<span class="sr-only"> (PDF)</span></a>' : "</a>",
                ),
              )
              .join("")}
          />
        </div>
      </aside>
    </div>
  </div>
</section>
