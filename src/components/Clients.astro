---
// Logos of companies my work has reached. Only names the companies publish
// themselves: Fieldeas lists its clients on its site, and IriusRisk names its
// customers in case studies and in the press. The logos are drawn in the
// text colour, so none of them fights the page. Tapping one opens a small
// card with a line about the company.
import { site } from "../lib/site";
const c = site.clients;
---

<section id={c.id} class="clients" aria-labelledby="clients-title">
  <div class="container clients-head">
    <h2 id="clients-title" class="clients-label">{c.label}</h2>
  </div>
  {
    c.groups.map((g, gi) => (
      <div class="marquee-group">
        <div class:list={["marquee", { reverse: gi % 2 === 1 }]}>
          {[0, 1, 2].map((copy) => (
            <ul class="marquee-track" aria-hidden={copy > 0 ? "true" : undefined}>
              {g.logos.map((l) => (
                <li>
                  <button
                    type="button"
                    class="logo"
                    tabindex={copy > 0 ? -1 : undefined}
                    aria-haspopup="dialog"
                    aria-controls="client-card"
                    data-name={l.name}
                    data-sector={l.sector}
                    data-about={l.about}
                  >
                  <img
                    draggable="false"
                    src={`/logos/${l.file}`}
                    alt={copy === 0 ? l.name : ""}
                    width={Math.round((l.height ?? 30) * l.ratio)}
                    height={l.height ?? 30}
                    style={l.height ? `height:${l.height}px` : undefined}
                    loading="lazy"
                    decoding="async"
                  />
                  </button>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    ))
  }
  <div id="client-card" class="client-card" role="dialog" aria-labelledby="client-card-name" hidden>
    <p id="client-card-name" class="client-card-name"></p>
    <p class="client-card-sector"></p>
    <p class="client-card-about"></p>
    <button type="button" class="client-card-close" aria-label={c.close}>×</button>
  </div>
</section>
