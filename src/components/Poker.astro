---
import { site } from "../lib/site";
import { renderLink, smart } from "../lib/render";
const p = site.poker;
// A 13 by 13 hand matrix drawn as an abstract opening range: pairs on the
// diagonal, suited hands above it, offsuit below, stronger hands brighter.
// Decorative only; it is not a real strategy chart.
const RANKS = 13;
const cells = Array.from({ length: RANKS * RANKS }, (_, k) => {
  const r = Math.floor(k / RANKS);
  const c = k % RANKS;
  const pair = r === c;
  const suited = c > r;
  const hi = Math.min(r, c);
  const lo = Math.max(r, c);
  const score = pair ? 26 - r * 1.6 : (12 - hi) * 1.7 + (12 - lo) + (suited ? 3.5 : 0) + (lo - hi === 1 ? 1.5 : 0);
  const inRange = pair ? r <= 10 : score >= (suited ? 20 : 25);
  const level = pair ? 1 - r * 0.05 : Math.min(1, 0.3 + (score - 18) / 16);
  return { level: inRange ? level : 0, pair };
});
---

<section id={p.id} class="section poker">
  <div class="container poker-inner">
    <div class="poker-copy reveal">
      <p class="kicker">{p.kicker}</p>
      <h2 class="section-title poker-title">{smart(p.title)}</h2>
      <p class="poker-text">{smart(p.text)}</p>
      <ul class="tags">
        {p.concepts.map((c) => <li>{c}</li>)}
      </ul>
      <Fragment set:html={renderLink(p.link, "poker-link")} />
    </div>
    <div class="range-grid reveal" aria-hidden="true">
      {
        cells.map((cell) => (
          <span class:list={{ pair: cell.pair }} style={cell.level ? `--l:${cell.level.toFixed(2)}` : undefined} />
        ))
      }
    </div>
  </div>
</section>
