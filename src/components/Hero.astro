---
import { Picture } from "astro:assets";
import { site } from "../lib/site";
import { portrait } from "../lib/images";

// Decorative backdrop behind the photo: a few lines from the maths I studied
// (Galois theory, optimization, probability) and from the tests I write.
const backdrop = [
  { text: "Gal(L/K) ≅ S₃", kind: "math", top: 6, left: 3 },
  { text: "x ∈ {0, 1}ⁿ", kind: "math", top: 3, left: 82 },
  { text: "[L : K] = |Gal(L/K)|", kind: "math", top: 18, left: 9 },
  { text: "min cᵀx  s.t.  Ax ≤ b", kind: "math", top: 31, left: 0 },
  { text: "∇f(x*) = λ∇g(x*)", kind: "math", top: 44, left: 6 },
  { text: "P(A | B) = P(B | A) P(A) / P(B)", kind: "math", top: 57, left: 0 },
  { text: "f(T(x)) = T′(f(x))", kind: "math", top: 69, left: 5 },
  { text: "expect(res.status).toBe(200)", kind: "code", top: 80, left: 0 },
  { text: "assert abs(sum(p) - 1) < ε", kind: "code", top: 87, left: 7 },
  { text: "expect(p95).toBeLessThan(200)", kind: "code", top: 94, left: 2 },
];
import { hrefOf, parseLabel, smart } from "../lib/render";

const h = site.hero;
const contact = parseLabel(h.contactLink);
// The name is the title, surname in italic.
const [first, ...rest] = h.name.split(" ");
const last = rest.join(" ");
---

<header class="hero">
  <div class="hero-grid-lines" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-copy">
      <h1 class="display hero-title">
        {first} <em>{last}</em>
      </h1>
      <p class="hero-text">{smart(h.text)}</p>
      <div class="hero-actions">
        {
          h.actions.map((a, i) => (
            <a class:list={["btn", i === 0 ? "btn-primary" : "btn-ghost"]} href={hrefOf(a.href)}>
              {a.label}
              {a.href.endsWith(".pdf") && <span class="sr-only"> (PDF)</span>}
            </a>
          ))
        }
        <a class="hero-contact" href={h.contactLink.href}>
          {contact.text} <span class="arrow" aria-hidden="true">{contact.arrow}</span>
        </a>
      </div>
    </div>
    <div class="hero-photo">
      <div class="hero-backdrop" aria-hidden="true">
        {
          backdrop.map((b) => (
            <span class:list={["glyph", b.kind]} style={`top:${b.top}%;left:${b.left}%`}>
              {b.text}
            </span>
          ))
        }
      </div>
      <Picture
        src={portrait}
        alt={h.photoAlt}
        widths={[320, 480, 720, 960]}
        sizes="(max-width: 960px) 280px, 440px"
        formats={["avif", "webp"]}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</header>
