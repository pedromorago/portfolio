---
import { Picture } from "astro:assets";
import { site } from "../lib/site";
import { portrait } from "../lib/images";
import { hrefOf, parseLabel, smart } from "../lib/render";

const h = site.hero;
const contact = parseLabel(h.contactLink);
// The name is the title, surname in italic.
const [first, ...rest] = h.name.split(" ");
const last = rest.join(" ");
---

<header class="hero">
  <div class="hero-grid-lines" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-copy">
      <h1 class="display hero-title">
        {first} <em>{last}</em>
      </h1>
      <p class="hero-text">{smart(h.text)}</p>
      <div class="hero-actions">
        {
          h.actions.map((a, i) => (
            <a class:list={["btn", i === 0 ? "btn-primary" : "btn-ghost"]} href={hrefOf(a.href)}>
              {a.label}
              {a.href.endsWith(".pdf") && <span class="sr-only"> (PDF)</span>}
            </a>
          ))
        }
        <a class="hero-contact" href={h.contactLink.href}>
          {contact.text} <span class="arrow" aria-hidden="true">{contact.arrow}</span>
        </a>
      </div>
    </div>
    <div class="hero-photo">
      <div class="hero-backdrop" aria-hidden="true"></div>
      <Picture
        src={portrait}
        alt={h.photoAlt}
        widths={[320, 480, 720, 960]}
        sizes="(max-width: 960px) 280px, 440px"
        formats={["avif", "webp"]}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</header>
