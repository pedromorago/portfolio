---
import { Picture } from "astro:assets";
import { site } from "../lib/site";
import { portrait } from "../lib/images";
import { hrefOf, inline } from "../lib/render";

const h = site.hero;
const [first, ...rest] = h.name.split(" ");
---

<header class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-grid-lines" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-copy">
      <div class="hero-meta">
        <p class="kicker">{h.eyebrow}</p>
        <p class="hero-place"><span class="dot" aria-hidden="true"></span>{h.place}</p>
      </div>
      <h1 class="display hero-name">
        <span>{first}</span>
        <span class="last">{rest.join(" ")}</span>
      </h1>
      <p class="hero-text" set:html={inline(h.text)} />
      <div class="hero-actions">
        {
          h.actions.map((a, i) => (
            <a class:list={["btn", i === 0 ? "btn-primary" : "btn-ghost"]} href={hrefOf(a.href)}>
              {a.label}
              {a.href.endsWith(".pdf") && <span class="sr-only"> (PDF)</span>}
            </a>
          ))
        }
      </div>
    </div>
    <div class="hero-photo">
      <Picture
        src={portrait}
        alt={h.photoAlt}
        widths={[380, 600, 900, 1200]}
        sizes="(max-width: 960px) 380px, 600px"
        formats={["avif", "webp"]}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
  <a class="hero-scroll" href="#work"><span class="hero-scroll-line" aria-hidden="true"></span>{h.scroll}</a>
</header>
