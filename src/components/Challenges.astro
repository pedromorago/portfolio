---
import { site } from "../lib/site";
import { smart, inline, renderLink } from "../lib/render";
import CiChart from "./CiChart.astro";
const c = site.challenges;
---

<section id={c.id} class="section challenges">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <p class="kicker">{c.kicker}</p>
        <h2 class="section-title">{smart(c.title)}</h2>
      </div>
      <p class="section-lede">{c.lede}</p>
    </div>
    {
      c.companies.map((co) => (
        <div class="challenge-company">
          <div class="challenge-company-head reveal">
            <h3>{co.company}</h3>
            <p>{co.context}</p>
          </div>
          {co.feature && (
            <article class="feature challenge-feature reveal">
              <div class="feature-copy">
                <p class="feature-index">Case study</p>
                <h4>{smart(co.feature.title)}</h4>
                <p class="feature-text" set:html={inline(co.feature.text)} />
                <ul class="tags">
                  {co.feature.tags.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
                <div class="card-links">
                  <Fragment set:html={renderLink(co.feature.link, "btn btn-small btn-light")} />
                </div>
              </div>
              <div class="feature-visual">
                <CiChart />
              </div>
            </article>
          )}
          <ol class="challenge-grid">
            {co.items.map((it, i) => (
              <li class="challenge reveal">
                <span class="step-num">{String(i + 1).padStart(2, "0")}</span>
                <h4>{it.title}</h4>
                <p>{it.problem}</p>
                <p class="challenge-how">How I approached it</p>
                <ul>
                  {it.approach.map((a) => (
                    <li>{a}</li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </div>
</section>
