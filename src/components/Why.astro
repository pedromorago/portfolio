---
import { site } from "../lib/site";
import { renderLink, smart } from "../lib/render";
const w = site.why;
---

<section id={w.id} class="section why">
  <div class="container">
    <div class="why-head reveal">
      <div>
        <p class="kicker">{w.kicker}</p>
        <h2 class="section-title">{smart(w.title)}</h2>
      </div>
      <svg class="venn" viewBox="0 0 240 210" aria-hidden="true" focusable="false">
        <circle cx="86" cy="82" r="62"></circle>
        <circle cx="154" cy="82" r="62"></circle>
        <circle cx="120" cy="140" r="62"></circle>
        <circle class="venn-core" cx="120" cy="102" r="9"></circle>
      </svg>
    </div>
    <ol class="why-grid">
      {
        w.items.map((it, i) => (
          <li class="why-item reveal">
            <span class="step-num">{String(i + 1).padStart(2, "0")}</span>
            <h3>{it.title}</h3>
            <p>{smart(it.text)}</p>
            <Fragment set:html={renderLink(it.link)} />
          </li>
        ))
      }
    </ol>
    <p class="why-closing reveal">{smart(w.closing)}</p>
  </div>
</section>
